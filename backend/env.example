# 应用配置
APP_NAME=合规审查知识库系统
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./data/compliance.db

# 文件存储配置
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=52428800  # 50MB

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text  # 嵌入模型名称（用于文档向量化，如果未下载可先使用deepseek-r1:7b）
OLLAMA_LLM_MODEL=deepseek-r1:7b  # 大语言模型名称（用于语义对比分析）

# 向量数据库配置
CHROMA_PERSIST_DIR=./data/chroma_db

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

